{
  "version": 2,
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**/*",
      "use": "@vercel/static"
    },
    {
      "src": "Attachement/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/public/(.*)",
      "dest": "/public/$1"
    },
    {
      "src": "/Attachement/(.*)",
      "dest": "/Attachement/$1"
    },
    {
      "src": "/styles.css",
      "dest": "/public/styles.css"
    },
    {
      "src": "/theme.css",
      "dest": "/public/theme.css"
    },
    {
      "src": "/script.js",
      "dest": "/public/script.js"
    },{
      "src": "/autres/quiz.html",
      "dest": "/public/autres/quiz.html"
    },
    {
      "src": "/autres/quizsimple/simple.html",
      "dest": "/public/autres/quizsimple/simple.html"
    },
    {
      "src": "/autres/quizscore/quizscore.html",
      "dest": "/public/autres/quizscore/quizscore.html"
    },
    {
      "src": "/profil2.jpg",
      "dest": "/public/photos/profil2.jpg"
    },
    {
      "src": "/photos/(.*)",
      "dest": "/public/photos/$1"
    },
    {
      "src": "/selectionner/(.*)",
      "dest": "/public/selectionner/$1"
    },
    {
      "src": "/jeux/(.*)",
      "dest": "/public/jeux/$1"
    },
    {
      "src": "/cours/math6eme/math6eme.html",
      "dest": "/public/cours/math6eme/math6eme.html"
    },
    {
      "src": "/cours/math6eme",
      "dest": "/public/cours/math6eme/math6eme.html"
    },
    {
      "src": "/cours/math5eme/math5eme.html",
      "dest": "/public/cours/math5eme/math5eme.html"
    },
    {
      "src": "/cours/math5eme",
      "dest": "/public/cours/math5eme/math5eme.html"
    },
    {
      "src": "/(.*)",
      "dest": "/index.js"
    }
  ]
}
